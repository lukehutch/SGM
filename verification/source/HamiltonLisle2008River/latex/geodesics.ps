%!
%%BoundingBox:     156    245    497    574
%%Creator:  ajsh
%%Title:  bonzo.ps
%%CreationDate:  Thu Mar 25 04:36:24 2004
%%PageMedia: Letter
%%PageOrientation: Portrait
% Begin fixed bonzo PostScript prologue
save /psbonzosave exch def
/$psbonzo 50 dict def
$psbonzo begin
% concatstrings procedure from gs_init.ps, needed by font-to-iso-latin-1
/concatstrings
	{ exch dup length 2 index length add string	% str2 str1 new
	  dup dup 4 2 roll copy				% str2 new new new1
	  length 4 -1 roll putinterval
	} bind def
% borrowed from gslp.ps
% build iso-latin-1 version of a font
/font-to-iso-latin-1 {  % <font> font-to-iso-latin-1 <font>
    %% reencode for iso latin1; from the 2nd edition red book, sec 5.6.1
    dup length dict begin {1 index /FID ne {def} {pop pop} ifelse} forall
    /Encoding ISOLatin1Encoding def currentdict end
    dup /FontName get 80 string cvs (-ISOLatin1) concatstrings cvn
    exch definefont
} def
/find-latin-font {	% <name> find-latin-font <font>
  findfont font-to-iso-latin-1
} def
/fonts [
   /Times-Roman findfont
   /Times-Italic findfont
   /Times-Bold findfont
   /Symbol findfont
   /Times-BoldItalic findfont
   /Helvetica findfont
   /Helvetica-Oblique findfont
   /Helvetica-Bold findfont
   /Symbol findfont
   /Helvetica-BoldOblique findfont
   /Times-Roman find-latin-font
   /Times-Italic find-latin-font
   /Times-Bold find-latin-font
   /Times-BoldItalic find-latin-font
   /Helvetica find-latin-font
   /Helvetica-Oblique find-latin-font
   /Helvetica-Bold find-latin-font
   /Helvetica-BoldOblique find-latin-font
   ] def
/Landscape {/pagewidth exch def /pageheight exch def
   90 rotate 0 pagewidth neg .75 sub translate} def
/Portrait {/pageheight exch def /pagewidth exch def} def
/Upsidedown {/pageheight exch def /pagewidth exch def
   180 rotate pagewidth neg .75 sub pageheight neg .5 sub translate} def
/W {initclip
    /ymax exch def /ymin exch def /xmax exch def /xmin exch def
    newpath xmin ymin moveto xmax ymin lineto xmax ymax lineto
    xmin ymax lineto closepath clip} def
/NW{initclip} def
/A {/angle exch def} def
/CF{sethsbcolor closepath fill} def
/CS{closepath stroke} def
/D {/ycur exch def /xcur exch def
    newpath xcur ycur moveto xcur ycur lineto 1 setlinecap
    stroke
    0 setlinecap} def
/F {/yoff exch def /xmove exch def /ysize exch def /xoff exch def
    /ymove exch def /xsize exch def /font exch def
    fonts font 1 sub get
    fm 0 xsize put
    fm 1 ymove put
    fm 2 xoff put
    fm 3 ysize put
    fm 4 xmove put
    fm 5 yoff put
    fm makefont setfont} def
/I {setlinewidth} def
/L {lineto} def
/M {moveto} def
/N {/ycur exch def /xcur exch def
    newpath xcur ycur moveto} def
/R {sethsbcolor} def
/S {stroke} def
/T {gsave currentpoint translate angle rotate show grestore} def
/Colrow {/rows exch def /cols exch def /colcount 1 def /rowcount 1 def} def
/Init {/angle 0 def
       /fm [1 0 0 1 0 0] def
       0 setlinewidth
       initclip} def
/Page {showpage
       colcount cols eq rowcount rows eq and
         {end psbonzosave restore}
         {rowcount rows eq
            {/rowcount 1 def colcount 1 add /colcount exch def}
            {rowcount 1 add /rowcount exch def} ifelse
         Init} ifelse
      } def
/Axis {/yorig exch def /xorig exch def
       savematrix setmatrix xorig yorig translate
       colcount 1 sub pagewidth mul neg
       rowcount 1 sub pageheight mul neg translate} def
72 72 scale
Init
% End of fixed prologue
 10.5 7.75 Portrait
 1 1 Colrow
/savematrix matrix currentmatrix def
