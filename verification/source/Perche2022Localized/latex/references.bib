@article{Katja,
	doi = {10.1088/1751-8121/aae78a},
	url = {https://doi.org/10.1088%2F1751-8121%2Faae78a},
	year = 2018,
	month = {oct},
	publisher = {{IOP} Publishing},
	volume = {51},
	number = {48},
	pages = {485301},
	author = {Robert H Jonsson and Katja Ried and Eduardo Mart{\'{i}}n-Mart{\'{i}}nez and Achim Kempf},
	title = {Transmitting qubits through relativistic fields},
	journal = {J. Phys. A},
	abstract = {Wireless communication derives its power from the simultaneous emission of signals in multiple directions. However, in the context of quantum communication, this phenomenon must be reconciled carefully with the no-cloning principle. In this context, we here study how wireless communication of quantum information can be realized via relativistic fields. To this end, we extend existing frameworks to allow for a non-perturbative description of, e.g. quantum state transfer. We consider, in particular, the case of 1+1 spacetime dimensions, which already allows for a number of interesting scenarios, pointing to, for example, new methods for tasks similar to quantum secret sharing.}
}
	
