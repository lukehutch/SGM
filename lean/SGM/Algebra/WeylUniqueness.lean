import SGM.Algebra.QuaternionSpinor
import Mathlib.LinearAlgebra.Dimension.Finrank
import Mathlib.Tactic

/-!
# Two-Sided 16-Element Basis, Rotation/Phase Uniqueness, and Majorana Conjugation
(`sgm_wavefn.tex` App. A.2 & Sec. 3.1)

Formalizes:
- `eq:two_sided_basis`: The 16 `ℝ`-linear endomorphisms `E_{μν}(ψ) = e_μ * ψ * e_ν` (`μ, ν ∈ Fin 4`)
  are linearly independent over `ℝ` (hence form a basis of `End_ℝ(ℍ)`).
- Rotation-and-phase uniqueness: Any `ℝ`-linear map `T : ℍ →ₗ[ℝ] ℍ` commuting with right
  multiplication by `e₃` and left `SU(2)` rotations (generated by `e₁, e₂, e₃`) has the form
  `T(ψ) = a ψ + b ψ e₃` (`a, b ∈ ℝ`).
- Majorana charge conjugation `C(ψ) = ψ * e₂` (`sgm_wavefn.tex` Sec. 3.1, App. A.3) satisfies
  `C(C(ψ)) = -ψ`, preserves `normSq`, commutes with all left rotations, and anticommutes
  with right `e₃` (`C(i ψ) = -i C(ψ)`).
-/

namespace SGM.Algebra

/-- The four quaternion basis units `(1, e₁, e₂, e₃)`. -/
def qBasis : Fin 4 → Quat
  | 0 => 1
  | 1 => e1
  | 2 => e2
  | 3 => e3

/-- Two-sided basis endomorphism `E_{μν}(ψ) = e_μ * ψ * e_ν` (`sgm_wavefn.tex` Eq. `eq:two_sided_basis`). -/
def twoSidedOp (p : Fin 4 × Fin 4) : Quat →ₗ[ℝ] Quat where
  toFun ψ := qBasis p.1 * ψ * qBasis p.2
  map_add' x y := by simp [mul_add, add_mul]
  map_smul' r x := by simp

/-- `sgm_wavefn.tex` Eq. `eq:two_sided_basis`:
The 16 two-sided maps `ψ ↦ e_μ ψ e_ν` are linearly independent over `ℝ`. -/
theorem twoSidedOp_linearIndependent : LinearIndependent ℝ twoSidedOp := by
  rw [Fintype.linearIndependent_iff]
  intro c hc p
  have h0 := congr_arg (fun f : Quat →ₗ[ℝ] Quat => f 1) hc
  have h1 := congr_arg (fun f : Quat →ₗ[ℝ] Quat => f e1) hc
  have h2 := congr_arg (fun f : Quat →ₗ[ℝ] Quat => f e2) hc
  have h3 := congr_arg (fun f : Quat →ₗ[ℝ] Quat => f e3) hc
  simp only [LinearMap.add_apply, LinearMap.smul_apply, LinearMap.zero_apply,
    twoSidedOp, LinearMap.coe_mk, AddHom.coe_mk, Fintype.sum_prod_type, Fin.sum_univ_four,
    qBasis] at h0 h1 h2 h3
  have e00 := congr_arg QuaternionAlgebra.re h0; have e01 := congr_arg QuaternionAlgebra.imI h0
  have e02 := congr_arg QuaternionAlgebra.imJ h0; have e03 := congr_arg QuaternionAlgebra.imK h0
  have e10 := congr_arg QuaternionAlgebra.re h1; have e11 := congr_arg QuaternionAlgebra.imI h1
  have e12 := congr_arg QuaternionAlgebra.imJ h1; have e13 := congr_arg QuaternionAlgebra.imK h1
  have e20 := congr_arg QuaternionAlgebra.re h2; have e21 := congr_arg QuaternionAlgebra.imI h2
  have e22 := congr_arg QuaternionAlgebra.imJ h2; have e23 := congr_arg QuaternionAlgebra.imK h2
  have e30 := congr_arg QuaternionAlgebra.re h3; have e31 := congr_arg QuaternionAlgebra.imI h3
  have e32 := congr_arg QuaternionAlgebra.imJ h3; have e33 := congr_arg QuaternionAlgebra.imK h3
  simp only [e1, e2, e3,
    QuaternionAlgebra.re_add, QuaternionAlgebra.imI_add, QuaternionAlgebra.imJ_add, QuaternionAlgebra.imK_add,
    QuaternionAlgebra.re_smul, QuaternionAlgebra.imI_smul, QuaternionAlgebra.imJ_smul, QuaternionAlgebra.imK_smul,
    QuaternionAlgebra.re_mul, QuaternionAlgebra.imI_mul, QuaternionAlgebra.imJ_mul, QuaternionAlgebra.imK_mul,
    QuaternionAlgebra.re_one, QuaternionAlgebra.imI_one, QuaternionAlgebra.imJ_one, QuaternionAlgebra.imK_one,
    QuaternionAlgebra.re_zero, QuaternionAlgebra.imI_zero, QuaternionAlgebra.imJ_zero, QuaternionAlgebra.imK_zero,
    smul_eq_mul, mul_zero, mul_one, one_mul, add_zero, zero_add, sub_zero, zero_sub,
    neg_zero, neg_neg, mul_neg] at e00 e01 e02 e03 e10 e11 e12 e13 e20 e21 e22 e23 e30 e31 e32 e33
  rcases p with ⟨i, j⟩
  match i, j with
  | 0, 0 | 0, 1 | 0, 2 | 0, 3
  | 1, 0 | 1, 1 | 1, 2 | 1, 3
  | 2, 0 | 2, 1 | 2, 2 | 2, 3
  | 3, 0 | 3, 1 | 3, 2 | 3, 3 => linarith

/-- Rotation-and-phase scalar uniqueness (`sgm_wavefn.tex` App. A.2):
Any `ℝ`-linear map `T : ℍ →ₗ[ℝ] ℍ` commuting with left `e₁, e₂, e₃` and right `e₃` is
`T(ψ) = a • ψ + b • (ψ * e₃)` for unique `a, b ∈ ℝ`. -/
theorem scalar_op_uniqueness (T : Quat →ₗ[ℝ] Quat)
    (hL1 : ∀ ψ, T (e1 * ψ) = e1 * T ψ)
    (hL2 : ∀ ψ, T (e2 * ψ) = e2 * T ψ)
    (hL3 : ∀ ψ, T (e3 * ψ) = e3 * T ψ)
    (hR3 : ∀ ψ, T (ψ * e3) = T ψ * e3) :
    ∃ a b : ℝ, ∀ ψ : Quat, T ψ = a • ψ + b • (ψ * e3) := by
  set c : Quat := T 1
  have hT_R : ∀ ψ : Quat, T ψ = ψ * c := by
    intro ψ
    have hdecomp : ψ = ψ.re • (1 : Quat) + ψ.imI • e1 + ψ.imJ • e2 + ψ.imK • e3 := by
      ext <;> simp [e1, e2, e3]
    conv_lhs => rw [hdecomp]
    simp only [map_add, map_smul]
    have h1' : T e1 = e1 * c := by simpa [mul_one] using hL1 1
    have h2' : T e2 = e2 * c := by simpa [mul_one] using hL2 1
    have h3' : T e3 = e3 * c := by simpa [mul_one] using hL3 1
    rw [h1', h2', h3']
    ext <;> simp [c, e1, e2, e3] <;> ring
  have hc_comm : e3 * c = c * e3 := by
    have := hR3 1
    rw [one_mul, hT_R e3] at this
    exact this
  have hc1 : c.imI = 0 := by
    have := congr_arg QuaternionAlgebra.imJ hc_comm
    simp [e3] at this; linarith
  have hc2 : c.imJ = 0 := by
    have := congr_arg QuaternionAlgebra.imI hc_comm
    simp [e3] at this; linarith
  refine ⟨c.re, c.imK, fun ψ => ?_⟩
  rw [hT_R ψ]
  ext <;> simp [e3, hc1, hc2] <;> ring

/-- Majorana / charge-conjugation operator `C(ψ) = ψ * e₂` (`sgm_wavefn.tex` Sec. 3.1, App. A.3). -/
def majoranaConj (ψ : Quat) : Quat := ψ * e2

theorem majoranaConj_sq (ψ : Quat) : majoranaConj (majoranaConj ψ) = -ψ := by
  ext <;> simp [majoranaConj, e2]

theorem majoranaConj_anticomm_e3 (ψ : Quat) :
    majoranaConj (ψ * e3) = -(majoranaConj ψ * e3) := by
  ext <;> simp [majoranaConj, e2, e3]

theorem majoranaConj_comm_left (R ψ : Quat) :
    majoranaConj (R * ψ) = R * majoranaConj ψ := by
  simp [majoranaConj, mul_assoc]

theorem majoranaConj_normSq (ψ : Quat) :
    qNormSq (majoranaConj ψ) = qNormSq ψ := by
  simp [majoranaConj, qNormSq, e2]
  ring

end SGM.Algebra
